{
  "_说明": "复制本文件为 config.json 后填写。config.json 含密钥，切勿提交到 GitHub。",

  "provider": "mock",
  "_provider选项": "mock=模拟不真发；aliyun=阿里云；tencent=腾讯云；custom=任意 HTTP 网关",

  "port": 8787,
  "concurrency": 6,
  "retries": 2,
  "delayMs": 0,
  "limitPerRequest": 1000,
  "token": "",

  "aliyun": {
    "accessKeyId": "",
    "accessKeySecret": "",
    "signName": "换成你审核通过的签名",
    "templateCode": "SMS_000000000",
    "regionId": "cn-hangzhou",
    "paramName": "name"
  },

  "tencent": {
    "secretId": "",
    "secretKey": "",
    "sdkAppId": "",
    "signName": "换成你审核通过的签名",
    "templateId": "000000",
    "region": "ap-guangzhou",
    "paramName": "name"
  },

  "custom": {
    "_说明": "body 里可用 {{phone}} {{name}} {{content}} {{templateCode}} {{signName}} 占位",
    "url": "https://example.com/sms/send",
    "method": "POST",
    "headers": {
      "Content-Type": "application/json; charset=utf-8",
      "Authorization": "Bearer 你的密钥"
    },
    "body": "{\"mobile\":\"{{phone}}\",\"content\":\"{{content}}\"}",
    "okField": "code",
    "templateCode": "",
    "signName": "",
    "paramName": "name"
  }
}
